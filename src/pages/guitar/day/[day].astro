---
import Base from "../../../layouts/Base.astro";
import LessonApp from "../../../app/LessonApp";
import { TOTAL_DAYS } from "../../../data/curriculum";
import { getCourse } from "../../../data/courses";

export function getStaticPaths() {
  return Array.from({ length: TOTAL_DAYS }, (_, i) => ({ params: { day: String(i + 1) } }));
}

const day = Number(Astro.params.day);
const t = getCourse("guitar", "pt").titles[day];
const title = t ? `Dia ${day}: ${t} · Guitarra · Pauta` : `Dia ${day} · Guitarra · Pauta`;
---

<Base title={title} instrument="guitar">
  <LessonApp day={day} instrument="guitar" locale="pt" client:load />
</Base>
