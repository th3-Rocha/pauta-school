---
import Base from "../../../../layouts/Base.astro";
import LessonApp from "../../../../app/LessonApp";
import { TOTAL_DAYS } from "../../../../data/curriculum";
import { getCourse } from "../../../../data/courses";

export function getStaticPaths() {
  return Array.from({ length: TOTAL_DAYS }, (_, i) => ({ params: { day: String(i + 1) } }));
}

const day = Number(Astro.params.day);
const t = getCourse("voice", "en").titles[day];
const title = t ? `Day ${day}: ${t} · Voice · Pauta` : `Day ${day} · Voice · Pauta`;
---

<Base title={title} lang="en" instrument="voice">
  <LessonApp day={day} instrument="voice" locale="en" translated={getCourse("voice", "en").lessons[day] ? null : undefined} client:load />
</Base>
