---
import Base from "../../../../layouts/Base.astro";
import LessonApp from "../../../../app/LessonApp";
import { TOTAL_DAYS } from "../../../../data/curriculum";
import { getCourse } from "../../../../data/courses";

export function getStaticPaths() {
  return Array.from({ length: TOTAL_DAYS }, (_, i) => ({ params: { day: String(i + 1) } }));
}

const day = Number(Astro.params.day);
const t = getCourse("keyboard", "en").titles[day];
const title = t ? `Day ${day}: ${t} · Keyboard · Pauta` : `Day ${day} · Keyboard · Pauta`;
---

<Base title={title} lang="en" instrument="keyboard">
  <LessonApp day={day} instrument="keyboard" locale="en" client:load />
</Base>
