---
import Base from "../../layouts/Base.astro";
import LessonApp from "../../app/LessonApp";
import { LESSON_TITLES, TOTAL_DAYS } from "../../data/curriculum";

export function getStaticPaths() {
  return Array.from({ length: TOTAL_DAYS }, (_, i) => ({ params: { day: String(i + 1) } }));
}

const day = Number(Astro.params.day);
const title = LESSON_TITLES[day] ? `Dia ${day}: ${LESSON_TITLES[day]} · Guitarra · Pauta` : `Dia ${day} · Guitarra · Pauta`;
---

<Base title={title}>
  <LessonApp day={day} instrument="guitarra" client:load />
</Base>
